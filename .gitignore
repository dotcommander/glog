# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Environment files
.env
.env.local
.env.*.local

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Log files
*.log
/logs/

# README/docs image assets may be WebP even when a user has a global *.webp ignore.
!docs/*.webp
# Web app static assets may be images even when a user has global image ignores.
!web/static/
!web/static/favicon.png
# Dashboard source must outrank a user-level logs/ ignore rule.
!web/src/lib/components/logs/
!web/src/lib/components/logs/**

# Build directories
build/
dist/
out/

# The dashboard build is embedded in release binaries and stays source-controlled.
!web/build/
!web/build/**

# Temporary files
tmp/
temp/
*.tmp

# Node modules (for web)
web/node_modules/
web/.svelte-kit/

# NPM/Yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite specific files
web/.vite/

# Coverage reports
coverage/
.nyc_output/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Binary specific
bin/glog
bin/glog.exe
/glog

# Config files with API keys
glog.json
*.json.bak
looper-state.json
scribe/
.work/

# Log files
*.log
